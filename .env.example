# Copy to .env and fill in. Nothing here is committed with real values; keep .env out of version control.

# --- Database (docker-compose overrides this for the containers) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobintel"

# --- Web auth (required) ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Seed user (used by `npm run seed`) ---
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="change-me-now"

# --- Scanner ---
# Identify your scanner honestly; some sites publish contact requirements in robots.txt.
SCAN_USER_AGENT="JobIntelBot/1.0 (+personal use; contact: you@example.com)"
SCAN_INTERVAL_P0_SECONDS=300
SCAN_INTERVAL_P1_SECONDS=900
SCAN_INTERVAL_P2_SECONDS=2700
SCAN_INTERVAL_P3_SECONDS=10800
# Store every posting (true) or only software/quant-relevant ones (false)
STORE_ALL_JOBS="false"
DEFAULT_TARGET_SEASON="Summer"
DEFAULT_TARGET_YEAR=2027
# Parallel company scans per tick
WORKER_CONCURRENCY=8
# Hours: on a company's very first scan, only alert for jobs posted within this window (prevents a flood of old roles)
FIRST_SCAN_ALERT_WINDOW_HOURS=6

# --- Alert delivery (all optional; unconfigured channels are skipped and reported as failed in Diagnostics) ---
DIGEST_TZ="America/New_York"
DIGEST_MORNING_HOUR=8
DIGEST_EVENING_HOUR=18
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
DISCORD_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_TO_NUMBER=""

# --- AI drafts and classification (optional; server-side only) ---
# anthropic | openai | none
AI_PROVIDER="none"
AI_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
