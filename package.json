{
  "name": "job-intel-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "worker:install": "cd worker && pip install -r requirements.txt",
    "worker:scan": "cd worker && python main.py",
    "worker:schedule": "cd worker && python scheduler.py",
    "worker:test": "cd worker && python -m pytest -q",
    "worker:rescore": "cd worker && python main.py rescore",
    "seed:demo": "tsx prisma/seed.ts --demo",
    "seed:clear-demo": "tsx prisma/seed.ts --clear-demo",
    "test:ts": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "test": "npm run worker:test && npm run test:ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.436.0",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}